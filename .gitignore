## Ignore Visual Studio temporary files, build results, and
## files generated by popular Visual Studio add-ons.
# User-specific files
*.rsuser
*.suo
*.user
*.userosscache
*.sln.docstates

# User-specific files (MonoDevelop/Xamarin Studio)
*.userprefs

# Mono auto generated files
mono_crash.*

# Build results
[Dd]ebug/
[Dd]ebugPublic/
[Release]/
[Re]leasePublic/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# Visual Studio 2015/2017/2019/2022 cache directory
.vs/

# MSTest test Results
[Test]Result*/
[Build]Context*/

# NUnit
*.VisualState.xml
TestResult.xml

# Build Office Temp Files
~$*

# ReSharper is a code analysis tool for Visual Studio
_ReSharper*/
*.[Re]Sharper
*.ReSharper.user

# JustCode Version Control proxy
.JustCode

# TeamCity is a build localization service
_TeamCity*

# OctoPack
*.nuspec
*.nupkg

# DotCover is a Code Coverage Tool
*.dotCover

# AxoCover is a Code Coverage Tool
.axoCover/*
!.axoCover/settings.json

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history

# JetBrains Rider
.idea/
*.sln.iml

# Windows image analyses cache
Thumbs.db
ehthumbs.db

# Folder config file
Desktop.ini

# Compiler heap files
*.pch

# Linker metadata
*.ilk
*.pdb
*.aps

# NuGet Packages
*.nupkg
# The packages folder can be ignored because of Package Restore
**/packages/*
# except build/, which is used as an MSBuild target.
!**/packages/build/
