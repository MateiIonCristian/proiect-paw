@* 
  --------------------------------------------------------------------------------
  DESCRIERE: Sablonul principal (Master Layout) al aplicatiei FirmeHub.
             Contine structura HTML de baza, header-ul cu meniul de navigare premium,
             zona de randare dinamica a paginilor (@RenderBody()) si footer-ul.
  --------------------------------------------------------------------------------
*@
<!DOCTYPE html>
<html lang="ro">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FirmeHub</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .navbar-brand { font-size: 1.5rem; font-weight: 800; color: #0dcaf0 !important; }
        .nav-link { font-weight: 500; transition: color 0.2s; }
        .nav-link:hover { color: #0dcaf0 !important; }
        .card { transition: transform 0.2s, box-shadow 0.2s; border: none; border-radius: 12px; }
        .card:hover { transform: translateY(-5px); box-shadow: 0 10px 20px rgba(0,0,0,0.1); }
        .btn-primary { border-radius: 8px; font-weight: 600; }
        footer { background: #fff; border-top: 1px solid #eee; padding: 20px 0; }
    </style>
</head>
<body class="bg-light">
    <header>
        <nav class="navbar navbar-expand-lg navbar-light navbar-premium sticky-top shadow-sm mb-4">
            <div class="container">
                <a class="navbar-brand navbar-brand-premium" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-rocket me-2"></i>FirmeHub
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1 ms-lg-4">
                        <li class="nav-item">
                            <a class="nav-link fw-bold px-3" asp-controller="Home" asp-action="Index">Acasă</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold px-3" asp-controller="Home" asp-action="Detalii">Detalii Site</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold px-3 text-primary" asp-controller="Firme" asp-action="Index">
                                <i class="fas fa-list-ul me-1"></i>Firme
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold px-3" asp-controller="Categorii" asp-action="Index">Categorii</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold px-3" asp-controller="Orase" asp-action="Index">Orașe</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link fw-bold px-3" asp-controller="Recenzii" asp-action="Index">Recenzii</a>
                        </li>
                    </ul>
                    <div class="d-flex align-items-center">
                        <partial name="_LoginPartial" />
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="text-center text-muted">
        <div class="container">
            &copy; 2026 - <strong>FirmeHub</strong> - Platformă Recenzii Firme
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
