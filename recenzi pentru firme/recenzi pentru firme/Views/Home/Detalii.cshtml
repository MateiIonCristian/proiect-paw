@*
    DESCRIERE:
    Vizualizare de prezentare generală a platformei ("Detalii Platformă").
    Descrie misiunea FirmeHub (transparență, recenzii verificate, căutare simplificată) și oferă legături rapide spre catalog sau înregistrare.
*@

@{
    ViewData["Title"] = "Detalii Platformă";
}

<div class="hero-gradient mb-5 py-5">
    <div class="container text-center animate-fade-up">
        <h1 class="display-4 fw-bold mb-3">Despre FirmeHub</h1>
        <p class="lead opacity-75">Transformăm feedback-ul în valoare pentru comunitate.</p>
    </div>
</div>

<div class="container mb-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <div class="card card-premium border-0 p-5 shadow-lg animate-fade-up">
                <div class="row align-items-center mb-5">
                    <div class="col-md-6">
                        <h2 class="fw-bold text-primary mb-4">Ce este FirmeHub?</h2>
                        <p class="text-muted fs-5">
                            FirmeHub este platforma centralizată unde clienții pot împărtăși experiențele lor reale cu firmele locale. 
                            Misiunea noastră este să aducem transparență și să ajutăm utilizatorii să facă alegeri informate.
                        </p>
                    </div>
                    <div class="col-md-6 text-center">
                        <div class="p-4 rounded-circle bg-primary bg-opacity-10 d-inline-block">
                            <i class="fas fa-bullseye fa-5x text-primary"></i>
                        </div>
                    </div>
                </div>

                <div class="row g-4 mt-2">
                    <div class="col-md-4">
                        <div class="text-center p-3">
                            <div class="mb-3">
                                <i class="fas fa-search-location fa-3x text-warning"></i>
                            </div>
                            <h4 class="fw-bold">Găsește Ușor</h4>
                            <p class="text-muted small">Filtrează firmele după oraș și categorie pentru a găsi exact ce cauți.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-3">
                            <div class="mb-3">
                                <i class="fas fa-star-half-alt fa-3x text-accent"></i>
                            </div>
                            <h4 class="fw-bold">Recenzii Reale</h4>
                            <p class="text-muted small">Doar utilizatorii autentificați pot lăsa recenzii, garantând autenticitatea.</p>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="text-center p-3">
                            <div class="mb-3">
                                <i class="fas fa-user-shield fa-3x text-success"></i>
                            </div>
                            <h4 class="fw-bold">Moderare Activă</h4>
                            <p class="text-muted small">Administratorii noștri se asigură că platforma rămâne un loc civilizat.</p>
                        </div>
                    </div>
                </div>

                <hr class="my-5 opacity-10">

                <div class="text-center">
                    <h3 class="fw-bold mb-4">Ești gata să începi?</h3>
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-controller="Firme" asp-action="Index" class="btn btn-premium px-4">Vezi Firmele</a>
                        <a asp-controller="Account" asp-action="Register" class="btn btn-premium-outline px-4">Creează Cont</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
