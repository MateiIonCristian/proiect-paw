@*
    DESCRIERE:
    Vizualizare destinată creării unei noi categorii de firme (Create).
    Contine un formular securizat prin antiforgery token pentru introducerea numelui categoriei.
*@

@model recenzi_pentru_firme.Models.Categorie

@{
    ViewData["Title"] = "Adaugă Categorie";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="fas fa-plus-circle me-2"></i>Categorie Nouă</h4>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <div class="mb-3">
                            <label asp-for="Nume" class="form-label fw-bold">Nume Categorie</label>
                            <input asp-for="Nume" class="form-control" placeholder="Ex: IT & Tehnologie" />
                            <span asp-validation-for="Nume" class="text-danger"></span>
                        </div>
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary">Salvează Categoria</button>
                            <a asp-action="Index" class="btn btn-outline-secondary">Anulează</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
