@*
    DESCRIERE:
    Pagina de listare a categoriilor de firme (Index).
    Afișează toate categoriile disponibile în aplicație sub formă de carduri interactive, cu opțiuni de editare și ștergere pentru administratori.
*@

@model IEnumerable<recenzi_pentru_firme.Models.Categorie>

@{
    ViewData["Title"] = "Administrare Categorii";
}

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="fw-bold"><i class="fas fa-tags text-primary me-2"></i>Categorii Firme</h1>
            <p class="text-muted">Organizează firmele pe domenii de activitate.</p>
        </div>
        <div class="col-md-6 text-md-end">
            @if (User.IsInRole("Administrator"))
            {
                <a asp-action="Create" class="btn btn-primary shadow-sm">
                    <i class="fas fa-plus-circle me-1"></i>Adaugă Categorie
                </a>
            }
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm border-0 border-start border-primary border-4">
                    <div class="card-body d-flex justify-content-between align-items-center">
                        <div>
                            <h5 class="fw-bold mb-0">@item.Nume</h5>
                            <small class="text-muted">ID: #@item.Id</small>
                        </div>
                        @if (User.IsInRole("Administrator"))
                        {
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit me-1"></i>Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash me-1"></i>Șterge</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
