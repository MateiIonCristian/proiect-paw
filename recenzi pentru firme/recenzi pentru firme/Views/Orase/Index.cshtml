@*
    DESCRIERE:
    Pagina de listare a orașelor înregistrate în sistem (Index).
    Afișează toate orașele sub formă de carduri stilizate, cu pictograme și controale de editare/ștergere dedicate exclusiv administratorilor.
*@

@model IEnumerable<recenzi_pentru_firme.Models.Oras>

@{
    ViewData["Title"] = "Administrare Orașe";
}

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="fw-bold"><i class="fas fa-city text-success me-2"></i>Orașe Disponibile</h1>
            <p class="text-muted">Gestionează zonele geografice pentru firme.</p>
        </div>
        <div class="col-md-6 text-md-end">
            @if (User.IsInRole("Administrator"))
            {
                <a asp-action="Create" class="btn btn-success shadow-sm">
                    <i class="fas fa-plus-circle me-1"></i>Adaugă Oraș
                </a>
            }
        </div>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-md-3 mb-4">
                <div class="card shadow-sm border-0 text-center">
                    <div class="card-body">
                        <div class="mb-3">
                            <i class="fas fa-map-marked-alt fa-3x text-light"></i>
                        </div>
                        <h5 class="fw-bold">@item.Nume</h5>
                        @if (User.IsInRole("Administrator"))
                        {
                            <div class="d-flex justify-content-center gap-2 mt-3">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning"><i class="fas fa-edit"></i> Edit</a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger"><i class="fas fa-trash"></i> Șterge</a>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
