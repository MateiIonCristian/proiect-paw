@*
    DESCRIERE:
    Pagina de listare a recenziilor (Index).
    Afișează recenziile scrise de utilizatori pentru diversele firme înregistrate, incluzând scorul sub formă de stele și opțiunile administrative de editare/ștergere.
*@

@model IEnumerable<recenzi_pentru_firme.Models.Recenzie>

@{
    ViewData["Title"] = "Recenzii Clienți";
}

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col-md-6">
            <h1 class="fw-bold"><i class="fas fa-star text-warning me-2"></i>Recenzii Recente</h1>
            <p class="text-muted">Opinia clienților despre firmele din platformă.</p>
        </div>
        <div class="col-md-6 text-md-end">
            <a asp-action="Create" class="btn btn-warning btn-lg shadow-sm">
                <i class="fas fa-pen-nib me-1"></i>Scrie o Recenzie
            </a>
        </div>
    </div>

    <div class="row">
        @if (Model != null && Model.Any())
        {
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <div>
                                    <h5 class="fw-bold mb-0">@item.Autor</h5>
                                    <span class="badge bg-light text-dark border mt-1">
                                        <i class="fas fa-building text-primary me-1"></i>@item.Firma?.Nume
                                    </span>
                                </div>
                                <div class="text-warning">
                                    @for (int i = 0; i < 5; i++)
                                    {
                                        <i class="@(i < item.Nota ? "fas" : "far") fa-star"></i>
                                    }
                                </div>
                            </div>
                            <p class="text-muted italic">"@item.Continut"</p>
                            @if (User.IsInRole("Administrator"))
                            {
                                <div class="d-flex gap-2 mt-3 pt-3 border-top">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning">
                                        <i class="fas fa-edit me-1"></i>Editează
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="fas fa-trash me-1"></i>Șterge
                                    </a>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        }
        else
        {
            <div class="col-12 text-center py-5">
                <i class="far fa-comment-dots fa-3x text-muted mb-3"></i>
                <p class="text-muted">Nu există încă recenzii. Fii primul care scrie una!</p>
            </div>
        }
    </div>
</div>
