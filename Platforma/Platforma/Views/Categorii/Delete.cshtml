@model Platforma.Models.Categorie
@{ ViewData["Title"] = "Șterge Categorie"; }

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card shadow border-0 p-4">
                <div class="text-danger mb-3">
                    <i class="fas fa-exclamation-triangle fa-3x"></i>
                </div>
                <h3 class="fw-bold mb-3">Sunteți sigur că doriți să ștergeți această categorie?</h3>
                <p class="text-muted mb-4">Categorie: <span class="fw-bold text-dark">@Model.Nume</span></p>
                
                <form asp-action="Delete">
                    <input type="hidden" asp-for="Id" />
                    <div class="d-flex justify-content-center gap-2">
                        <button type="submit" class="btn btn-danger fw-bold px-4 shadow-sm">Confirmă Ștergerea</button>
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Anulează</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
