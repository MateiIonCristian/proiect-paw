@model IEnumerable<Platforma.Models.Categorie>
@{ ViewData["Title"] = "Categorii"; }

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold m-0">Administrare Categorii</h2>
        <a asp-action="Create" class="btn btn-primary shadow-sm fw-bold px-4">+ Adaugă Categorie</a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <table class="table table-hover mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3">Nume Categorie</th>
                        <th class="text-end pe-4 py-3">Acțiuni</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model) {
                        <tr>
                            <td class="ps-4 align-middle fw-semibold">@item.Nume</td>
                            <td class="text-end pe-4 align-middle">
                                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-warning me-1">
                                    <i class="fas fa-edit"></i> Editează
                                </a>
                                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger">
                                    <i class="fas fa-trash-alt"></i> Șterge
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
