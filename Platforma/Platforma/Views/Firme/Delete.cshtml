@model Platforma.Models.Firma

@{
    ViewData["Title"] = "Șterge Firmă";
}

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6 bg-white p-5 shadow rounded border-top border-5 border-danger text-center">
            <i class="fas fa-trash-alt fa-4x text-danger mb-4"></i>
            <h2 class="fw-bold mb-3">Ești sigur?</h2>
            <p class="text-muted mb-5 lead">
                Sigur dorești să ștergi firma <strong>@Model.Nume</strong>? Această acțiune va șterge automat și toate recenziile asociate acesteia.
            </p>
            
            <form asp-action="Delete" method="post" class="d-flex gap-3 justify-content-center">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-secondary px-5">Anulează</a>
                <button type="submit" class="btn btn-danger px-5 fw-bold shadow-sm">Șterge Definitiv</button>
            </form>
        </div>
    </div>
</div>
